{
  "nodes": [
    {
      "id": "changan",
      "name": "长安（镐京/西京）",
      "type": "古都",
      "pos": [
        34.34,
        108.94
      ],
      "year_start": -1046,
      "year_end": 907,
      "color": "#2563eb",
      "note": "西周宗周镐京，西汉、新莽、东汉献帝、西晋愍帝、前赵、前秦、后秦、西魏、北周、隋、唐等十三朝古都。陆上丝绸之路东方起点，全盛时人口超百万，是古代东方世界文明中心。"
    },
    {
      "id": "luoyang",
      "name": "洛阳（洛邑/东都）",
      "type": "古都",
      "pos": [
        34.62,
        112.45
      ],
      "year_start": -770,
      "year_end": 960,
      "color": "#2563eb",
      "note": "东周、东汉、曹魏、西晋、北魏、隋、唐（神都/东都）、后梁、后唐等定都于此。九朝都会，地处天下之中，隋唐大运河以洛阳为中心贯通南北。"
    },
    {
      "id": "xianyang",
      "name": "咸阳",
      "type": "古都",
      "pos": [
        34.33,
        108.71
      ],
      "year_start": -350,
      "year_end": -206,
      "color": "#1f2937",
      "note": "战国秦孝公迁都于此，商鞅变法奠基；秦始皇在此统一六国建立大秦帝国，修筑咸阳宫与阿房宫，项羽入关焚之。"
    },
    {
      "id": "beijing",
      "name": "北京（蓟/幽州/中都/大都）",
      "type": "古都",
      "pos": [
        39.9,
        116.4
      ],
      "year_start": -1046,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "先秦燕国都蓟，辽为陪都南京，金迁都中都，元建大都，明成祖迁都北京，清沿袭为国都。华北平原北端门户，连接中原农耕与北方游牧文明。"
    },
    {
      "id": "nanjing",
      "name": "南京（建康/金陵/应天）",
      "type": "古都",
      "pos": [
        32.06,
        118.79
      ],
      "year_start": 229,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "东吴、东晋、宋、齐、梁、陈六朝古都；明太祖朱元璋建都应天府；太平天国天京；中华民国首都。长江下游龙盘虎踞之要塞。"
    },
    {
      "id": "kaifeng",
      "name": "开封（大梁/汴州/汴京）",
      "type": "古都",
      "pos": [
        34.79,
        114.31
      ],
      "year_start": -361,
      "year_end": 1127,
      "color": "#2563eb",
      "note": "战国魏都大梁，五代后梁、后晋、后汉、后周及北宋（东京汴梁）定都于此。水陆舟车交会，张择端《清明上河图》描绘其极盛繁华。"
    },
    {
      "id": "hangzhou",
      "name": "临安（杭州）",
      "type": "古都",
      "pos": [
        30.27,
        120.15
      ],
      "year_start": 589,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "五代吴越国都，南宋行在（国都）。隋唐大运河南端终点，马可·波罗赞誉为‘世界上最美丽华贵之天城’。"
    },
    {
      "id": "yinchuan",
      "name": "兴庆府（银川）",
      "type": "古都",
      "pos": [
        38.48,
        106.23
      ],
      "year_start": 1038,
      "year_end": 1227,
      "color": "#0284c7",
      "note": "西夏国都（兴庆府/中兴府），李元昊在此建国。地处宁夏平原黄河灌区，‘塞上江南’核心。"
    },
    {
      "id": "shenyang",
      "name": "盛京（沈阳）",
      "type": "古都",
      "pos": [
        41.8,
        123.43
      ],
      "year_start": 1625,
      "year_end": 1912,
      "color": "#0369a1",
      "note": "后金努尔哈赤与皇太极迁都于此建盛京宫殿；顺治入关后定为清朝陪都。东北重镇与满洲发祥地。"
    },
    {
      "id": "dunhuang",
      "name": "敦煌",
      "type": "重镇",
      "pos": [
        40.14,
        94.66
      ],
      "year_start": -111,
      "year_end": 1945,
      "color": "#d97706",
      "note": "汉武帝设河西四郡之一，‘敦，大也；煌，盛也’。丝绸之路咽喉总汇，莫高窟千佛洞汇集东西方千年艺术与佛教文化瑰宝。"
    },
    {
      "id": "chengdu",
      "name": "成都（锦官城）",
      "type": "重镇",
      "pos": [
        30.66,
        104.06
      ],
      "year_start": -316,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "蜀汉国都、成汉、前蜀、后蜀之都。李冰修筑都江堰造就‘天府之国’，西南政治、经济与文化中心。"
    },
    {
      "id": "guangzhou",
      "name": "广州（番禺）",
      "type": "重镇",
      "pos": [
        23.13,
        113.26
      ],
      "year_start": -214,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "南越国都，海上丝绸之路发祥地与中国古代最大对外贸易港口，唐设市舶使，清初设‘十三行’独揽对西洋贸易。"
    },
    {
      "id": "hangu_pass",
      "name": "函谷关",
      "type": "关隘",
      "pos": [
        34.64,
        110.91
      ],
      "year_start": -1046,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "中国历史上最著名的战略咽喉之一。西据高原，东临绝涧，南接秦岭，北塞黄河。战国六国攻秦在此‘伏尸百万，流血漂橹’；老子在此著《道德经》出关。"
    },
    {
      "id": "tongguan_pass",
      "name": "潼关",
      "type": "关隘",
      "pos": [
        34.55,
        110.29
      ],
      "year_start": 196,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "东汉末曹操所设，取代函谷关成为关中东大门。南依秦岭、北濒黄河，‘峰峦如聚，波涛如怒，山河表里潼关路’，历代兵家必争之地。"
    },
    {
      "id": "yumen_pass",
      "name": "玉门关",
      "type": "关隘",
      "pos": [
        40.35,
        93.86
      ],
      "year_start": -111,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "汉武帝列四郡据两关之一，西通西域北道与中亚。王之涣《凉州词》：‘羌笛何须怨杨柳，春风不度玉门关’。"
    },
    {
      "id": "yangguan_pass",
      "name": "阳关",
      "type": "关隘",
      "pos": [
        39.92,
        94.19
      ],
      "year_start": -111,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "汉代丝绸之路南道门户，因在玉门关之南而得名。王维千古绝唱：‘劝君更尽一杯酒，西出阳关无故人’。"
    },
    {
      "id": "shanhai_pass",
      "name": "山海关",
      "type": "关隘",
      "pos": [
        40.0,
        119.75
      ],
      "year_start": 1381,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "明洪武年间徐达所建，‘天下第一关’。北倚燕山，南连渤海，锁扼辽西走廊。1644年吴三桂引清军入关由此改变中国历史轨迹。"
    },
    {
      "id": "jiayu_pass",
      "name": "嘉峪关",
      "type": "关隘",
      "pos": [
        39.81,
        98.22
      ],
      "year_start": 1372,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "明代万里长城西端终点，‘天下第一雄关’。控扼河西走廊咽喉，扼守黑山与祁连山之间峡谷。"
    },
    {
      "id": "juyong_pass",
      "name": "居庸关",
      "type": "关隘",
      "pos": [
        40.29,
        116.07
      ],
      "year_start": -500,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "太行八陉之军都陉，燕京西北门户天险，‘居庸之险不在关而在峡’，包含八达岭等长城险隘。"
    },
    {
      "id": "yanmen_pass",
      "name": "雁门关",
      "type": "关隘",
      "pos": [
        39.18,
        112.87
      ],
      "year_start": -300,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "‘中华第一关’，长城重要关隘。李牧击匈奴、昭君出塞、杨家将抗辽守关之地，屏障太原与中原平原。"
    },
    {
      "id": "jianmen_pass",
      "name": "剑门关",
      "type": "关隘",
      "pos": [
        32.25,
        105.56
      ],
      "year_start": -316,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "大剑山与小剑山中断处，‘一夫当关，万夫莫开’（李白《蜀道难》）。诸葛亮设关垒，姜维凭此险阻挡钟会十万魏军。"
    },
    {
      "id": "dasan_pass",
      "name": "大散关",
      "type": "关隘",
      "pos": [
        34.25,
        106.98
      ],
      "year_start": -206,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "秦岭要隘，陈仓古道咽喉。陆游《书愤》：‘早岁那知世事艰，中原北望气如山。楼船夜雪瓜洲渡，铁马秋风大散关’，南宋与金朝对峙西段边界。"
    },
    {
      "id": "rome",
      "name": "罗马（Rome）",
      "type": "古都",
      "pos": [
        41.9,
        12.5
      ],
      "year_start": -753,
      "year_end": 1945,
      "color": "#991b1b",
      "note": "‘永恒之城’，罗马王国、罗马共和国与罗马帝国的发源地与首都，西方古典法学、工程学与政治制度奠基地。"
    },
    {
      "id": "constantinople",
      "name": "君士坦丁堡（伊斯坦布尔）",
      "type": "古都",
      "pos": [
        41.01,
        28.98
      ],
      "year_start": 330,
      "year_end": 1945,
      "color": "#4338ca",
      "note": "君士坦丁大帝定都建立新罗马，拜占庭帝国千年首都；1453年被奥斯曼帝国攻克后为奥斯曼帝国首都。控扼博斯普鲁斯海峡与欧亚交界要冲。"
    },
    {
      "id": "athens",
      "name": "雅典（Athens）",
      "type": "古都",
      "pos": [
        37.98,
        23.73
      ],
      "year_start": -800,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "古希腊城邦文明巅峰，西方民主制度、哲学（苏格拉底、柏拉图、亚里士多德）、戏剧与古典艺术发源地。卫城帕特农神庙屹立于此。"
    },
    {
      "id": "alexandria",
      "name": "亚历山大港（Alexandria）",
      "type": "名城",
      "pos": [
        31.2,
        29.92
      ],
      "year_start": -331,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "亚历山大大帝建立，托勒密王朝首都。古代世界最大图书馆与古代世界七大奇迹之一‘亚历山大灯塔’所在地，希腊化科学与文化中心。"
    },
    {
      "id": "carthage",
      "name": "迦太基（Carthage）",
      "type": "古都",
      "pos": [
        36.85,
        10.32
      ],
      "year_start": -814,
      "year_end": 698,
      "color": "#c2410c",
      "note": "腓尼基人在北非建立的商业与海洋霸权帝国，三次布匿战争与罗马争霸，名将汉尼拔由此出征横越阿尔卑斯山突袭罗马本土。"
    },
    {
      "id": "antioch",
      "name": "安条克（Antioch）",
      "type": "名城",
      "pos": [
        36.2,
        36.16
      ],
      "year_start": -300,
      "year_end": 1945,
      "color": "#2563eb",
      "note": "塞琉古帝国首都，罗马帝国东方第三大都市，丝绸之路在地中海的终点枢纽与早期基督教传播重镇。"
    },
    {
      "id": "baghdad",
      "name": "巴格达（Baghdad）",
      "type": "古都",
      "pos": [
        33.31,
        44.36
      ],
      "year_start": 762,
      "year_end": 1945,
      "color": "#047857",
      "note": "阿拉伯阿拔斯王朝（黑衣大食）首都，哈里发曼苏尔所建‘和平之城’，建‘智慧之宫’开展百年翻译运动，伊斯兰黄金时代的科学文化心脏。"
    },
    {
      "id": "damascus",
      "name": "大马士革（Damascus）",
      "type": "古都",
      "pos": [
        33.51,
        36.29
      ],
      "year_start": -1000,
      "year_end": 1945,
      "color": "#047857",
      "note": "人类最古老持续有人居住的城市之一，阿拉伯帝国倭马亚王朝（白衣大食）首都，大马士革清真寺（倭马亚大清真寺）所在地。"
    },
    {
      "id": "jerusalem",
      "name": "耶路撒冷（Jerusalem）",
      "type": "圣城",
      "pos": [
        31.77,
        35.21
      ],
      "year_start": -1000,
      "year_end": 1945,
      "color": "#ca8a04",
      "note": "犹太教、基督教与伊斯兰教三教共同圣地，包含圆顶清真寺、哭墙与圣墓教堂，十字军东征与千年地缘争夺的核心。"
    },
    {
      "id": "babylon",
      "name": "巴比伦（Babylon）",
      "type": "古都",
      "pos": [
        32.54,
        44.42
      ],
      "year_start": -2000,
      "year_end": -100,
      "color": "#7e22ce",
      "note": "美索不达米亚平原两河流域核心，古巴比伦汉谟拉比法典、新巴比伦空中花园与尼布甲尼撒二世帝都，亚历山大大帝逝世于此。"
    },
    {
      "id": "persepolis",
      "name": "波斯波利斯（Persepolis）",
      "type": "古都",
      "pos": [
        29.93,
        52.89
      ],
      "year_start": -518,
      "year_end": -330,
      "color": "#9333ea",
      "note": "波斯帝国阿契美尼德王朝礼仪首都，大流士一世所建万国门与宏伟宫殿群，公元前330年被亚历山大大帝攻占焚毁。"
    },
    {
      "id": "ctesiphon",
      "name": "泰西封（Ctesiphon）",
      "type": "古都",
      "pos": [
        33.09,
        44.58
      ],
      "year_start": -120,
      "year_end": 637,
      "color": "#7e22ce",
      "note": "底格里斯河畔名都，帕提亚帝国（安息）与萨珊波斯帝国首都，存留壮观的萨珊拱券建筑‘泰西封塔克’。"
    },
    {
      "id": "thermopylae",
      "name": "温泉关（Thermopylae）",
      "type": "要塞",
      "pos": [
        38.8,
        22.54
      ],
      "year_start": -480,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "希腊中东部沿海悬崖狭隘通道。公元前480年斯巴达国王列奥尼达率300勇士与希腊联军在此抗击数十万波斯入侵大军壮烈殉国。"
    },
    {
      "id": "gibraltar",
      "name": "直布罗陀（赫拉克勒斯之柱）",
      "type": "要塞",
      "pos": [
        36.14,
        -5.35
      ],
      "year_start": -700,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "控扼地中海通往大西洋唯一天然海峡出口的咽喉巨岩要塞，古典时代称为‘赫拉克勒斯之柱’，西方世界航海地理边界。"
    },
    {
      "id": "dardanelles",
      "name": "达达尼尔海峡要塞（加里波利）",
      "type": "要塞",
      "pos": [
        40.2,
        26.4
      ],
      "year_start": -500,
      "year_end": 1945,
      "color": "#dc2626",
      "note": "连接爱琴海与马尔马拉海的关键海峡通道，古代特洛伊战争发生地，薛西斯一世浮桥渡海，一战加里波利战役要冲。"
    }
