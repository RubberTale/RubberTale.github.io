  "cards": [
    {
      "dot": "amber",
      "title": "商鞅变法与始皇千古一统",
      "items": [
        "商鞅入秦推行彻底变法，废井田立县制、论军功行赏，奠定秦国虎狼之师横扫六合的制度根基",
        "秦始皇嬴政以雄才大略任用李斯、尉缭、王翦，十年扫灭齐楚燕韩赵魏，终结春秋战国五百年混战",
        "初创'皇帝'尊号，废除分封立郡县，书同文、车同轨、统一度量衡，筑万里长城，铸就华夏两千年帝制范式"
      ]
    },
    {
      "dot": "cyan",
      "title": "沙丘之变与十四载速亡之谜",
      "items": [
        "公元前210年始皇病逝沙丘，赵高联合李斯伪造遗诏，赐死长子扶苏与名将蒙恬，立幼子胡亥为二世",
        "胡亥残害血亲屠戮忠良，繁重徭役修骊山阿房宫，终于引发陈胜吴广'大泽乡起义'，天下云合响应",
        "赵高望夷宫逼死二世立子婴，子婴计除赵高，沛公兵临咸阳素车白马出降，开创大一统的强秦仅十四载而亡"
      ]
    },
    {
      "dot": "rose",
      "title": "巨鹿破釜与垓下悲歌汉祖代立",
      "items": [
        "西楚霸王项羽巨鹿之战'破釜沉舟'大破秦军主力二十万，收降章邯诸将，威震天下分封十八诸侯",
        "沛公刘邦入关约法三章收揽民心，还定三秦任用韩信、张良、萧何，历经四年楚汉相争决战垓下",
        "项羽十面埋伏四面楚歌霸王别姬自刎乌江，刘邦公元前202年即皇帝位于定陶建立大汉，汉承秦制开启四百年盛世"
      ]
    }
