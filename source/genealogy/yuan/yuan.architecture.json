  "cards": [
    {
      "dot": "amber",
      "title": "大蒙古国铁骑西征与世祖忽必烈混一",
      "items": [
        "成吉思汗统一蒙古草原，制定扎撒大典，发动三次大规模西征横扫欧亚大陆，建立人类史上空前庞大的帝国",
        "忽必烈取《易经》'大哉乾元'建国号大元，营建大都（今北京），1279年崖山海战灭南宋，终结分裂混一天下",
        "创立行中书省制度（行省制），奠定中国后世数百年地方行政制度的基石"
      ]
    },
    {
      "dot": "cyan",
      "title": "延祐复科与中后期频繁政变",
      "items": [
        "元仁宗推行汉法，恢复中断数十年的科举取士（延祐复科），汉蒙藏多民族文化深度交融",
        "元朝皇位继承缺乏稳定宗法制度，南坡之变、两都之战连续爆发，短短三十年间更迭十帝，权臣频频专政弑君",
        "文宗设奎章阁编修《经世大典》，元曲杂剧与书画繁荣，诞生关汉卿、赵孟頫、黄公望等艺术巨匠"
      ]
    },
    {
      "dot": "rose",
      "title": "红巾军起义与元顺帝北奔",
      "items": [
        "元末黄河决口，丞相脱脱治理黄河引发白莲教红巾军大起义，天下群雄并起割据四方",
        "1368年朱元璋在南京称帝建立大明，徐达统帅二十万北伐军克复大都，元顺帝妥懽帖睦尔开健德门北奔漠北",
        "元朝残余势力退回蒙古草原延续为'北元'，捕鱼儿海大败后瓦解为鞑靼与瓦剌，享国九十八年终"
      ]
    }
  ]
