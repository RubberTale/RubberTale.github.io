  "cards": [
    {
      "dot": "amber",
      "title": "靖难之役与成祖北迁定都",
      "items": [
        "建文削藩过激，燕王朱棣以'清君侧'为名起兵靖难，1402年攻陷南京夺取皇位",
        "成祖迁都北京，天子守国门，五征漠北、七下西洋、修永乐大典，铸就永乐全盛",
        "靖难之变使大明皇统由懿文太子一脉彻底转入成祖燕王一脉"
      ]
    },
    {
      "dot": "cyan",
      "title": "土木之变与夺门复辟惊魂",
      "items": [
        "1449年明英宗轻率北征惨败瓦剌俘于土木堡，于谦力挽狂澜拥立代宗取得京师保卫战大捷",
        "景泰帝拒不复立英宗，1457年石亨徐有贞发动'夺门之变'迎英宗复辟，于谦冤死",
        "土木堡之变是大明由攻转守的分水岭，京营精锐丧尽，边防从此陷入战略被动"
      ]
    },
    {
      "dot": "rose",
      "title": "天子守国门与甲申煤山殉节",
      "items": [
        "明代宗藩恪守'不和亲、不赔款、不割地、天子守国门、君王死社稷'之铁律",
        "1644年李自成大顺军破北京，崇祯帝朱由检自缢景山寿皇亭，大明正统享国276年终",
        "南明弘光、隆武、永历转战大江南北十八载，最终永历帝死于缅甸，日月同辉成绝响"
      ]
    }
  ]
